{
  "name": "auto-doc-mcp",
  "version": "0.2.1",
  "description": "Autonomous documentation generation MCP server that writes living user and admin manuals in Notion as features are completed.",
  "type": "module",
  "license": "MIT",
  "author": "bido75",
  "homepage": "https://github.com/bido75/Auto-Documentation-MCP-Server#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bido75/Auto-Documentation-MCP-Server.git"
  },
  "bugs": {
    "url": "https://github.com/bido75/Auto-Documentation-MCP-Server/issues"
  },
  "keywords": [
    "mcp",
    "documentation",
    "notion",
    "ai",
    "developer-tools",
    "cursor",
    "vscode",
    "claude",
    "automatic-documentation"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "main": "./build/src/index.js",
  "types": "./build/src/index.d.ts",
  "files": [
    "build/",
    "README.md",
    "QUICKSTART.md",
    "LICENSE",
    "docs/SELF-HOSTING.md",
    "docs/TOOLS.md",
    "docs/CONFIGURATION.md"
  ],
  "bin": {
    "auto-docs-notion-mcp": "build/src/index.js",
    "auto-doc-mcp": "build/src/cli/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "clean": "node -e \"require('node:fs').rmSync('build',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:live-notion": "vitest run tests/integration/live-notion.integration.test.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run build && npm test",
    "postpublish": "node -e \"const p=require('./package.json'); console.log('Published '+p.name+'@'+p.version)\"",
    "start": "node build/src/index.js",
    "cli": "node build/src/cli/index.js",
    "init": "node build/src/cli/index.js init",
    "prompts:sync": "node scripts/sync-prompt-repo.mjs",
    "prompts:sync:dry-run": "node scripts/sync-prompt-repo.mjs --dry-run",
    "failover:smoke": "node scripts/forced-cloud-failover-smoke.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.100.1",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@notionhq/client": "^2.2.15",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.22.2",
    "openai": "^6.39.1",
    "playwright": "^1.54.2",
    "simple-git": "^3.27.0",
    "yaml": "^2.9.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.0",
    "nock": "^13.5.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "form-data": "4.0.6",
    "hono": "4.12.27"
  }
}
