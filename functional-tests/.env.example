# Functional test configuration — copy to .env and fill in.
# POINT THIS AT A DISPOSABLE NOTION WORKSPACE. These tests create real pages.

# --- Required for smoke-pipeline.js (stdio MCP mode) ---
NOTION_TOKEN=secret_xxx_integration_token_for_throwaway_workspace
NOTION_PARENT_PAGE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# How to launch the server in stdio MCP mode (adjust to your build output):
AUTO_DOC_SERVER_CMD=node
AUTO_DOC_SERVER_ARGS=["dist/index.js"]
AUTO_DOC_SERVER_CWD=/absolute/path/to/manual-creator

# A unique, non-default encryption key (required if the prod secret-guard is active):
STATE_ENCRYPTION_KEY=generate-a-unique-32+char-key-here

# --- Required for smoke-bridge.js (HTTP/SSE bridge mode) ---
AUTO_DOC_BRIDGE_CMD=node
AUTO_DOC_BRIDGE_ARGS=["dist/index.js"]
AUTO_DOC_BRIDGE_CWD=/absolute/path/to/manual-creator
AUTO_DOC_BRIDGE_ENV={"AUTO_DOC_RUNTIME_MODE":"bridge"}
AUTO_DOC_BRIDGE_PORT=3000

# Optional — enables extra bridge assertions when provided:
BRIDGE_CLIENT_TOKEN=a-valid-client-token-the-bridge-accepts
WEBHOOK_SECRET=the-hmac-secret-configured-for-webhooks

# Set VERBOSE=1 to stream server stderr/stdout during tests.
